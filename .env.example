# Copie para .env.local e preencha. Nunca commite o .env.local.

# OpenRouter (https://openrouter.ai/keys) — usado só no servidor
OPENROUTER_API_KEY=
# Ex.: um modelo listado em https://openrouter.ai/models
OPENROUTER_MODEL=
# Transcrição de áudio (opcional). Padrão: openai/whisper-large-v3-turbo
OPENROUTER_MODEL_TRANSCRICAO=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ignora RLS: só no servidor, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Senha de acesso (HTTP Basic Auth, qualquer usuário). Vazio = sem bloqueio (dev local).
APP_PASSWORD=
