# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# saídas do Playwright MCP (screenshots e logs temporários)
/.playwright-mcp/

# ferramentas locais do agente (skills e configurações de cada máquina; não fazem parte do app)
.agents/
.claude/agents/
.claude/settings.local.json
.claude/skills/impeccable/
.claude/skills/ui-ux-pro-max/
skills-lock.json
.playwright-mcp/

# gravações de teste do áudio (voz é dado pessoal; nunca vão para o git)
/audios-teste/*
!/audios-teste/LEIA-ME.md
